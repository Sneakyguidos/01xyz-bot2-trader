{
  "name": "01xyz-bot2-trader",
  "version": "1.0.0",
  "description": "Trading bot for 01.xyz exchange",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "npm run build && npm run start",
    "clean": "rm -rf dist",
    "rebuild": "npm run clean && npm run build",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "trading",
    "bot",
    "01xyz",
    "nord-ts",
    "solana",
    "crypto"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@n1xyz/nord-ts": "^0.3.5",
    "@solana/web3.js": "^1.87.6",
    "bn.js": "^5.2.2",
    "dotenv": "^16.3.1",
    "inquirer": "^9.3.8"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/inquirer": "^9.0.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.18.0",
    "@typescript-eslint/parser": "^6.18.0",
    "eslint": "^8.56.0",
    "jest": "^30.2.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.4.6",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
