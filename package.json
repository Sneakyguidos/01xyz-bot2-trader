{
  "name": "01xyz-bot2-trader",
  "version": "1.0.0",
  "description": "Trading bot for 01.xyz exchange",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "npm run build && npm run start",
    "clean": "rm -rf dist",
    "rebuild": "npm run clean && npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "trading",
    "bot",
    "01xyz",
    "nord-ts",
    "solana",
    "crypto"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@n1xyz/nord-ts": "^0.3.5",
    "@solana/web3.js": "^1.87.6",
    "bn.js": "^5.2.1",
    "bs58": "^5.0.0",
    "dotenv": "^16.3.1",
    "inquirer": "^9.2.12"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.5",
    "@types/bs58": "^4.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.10.6",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
